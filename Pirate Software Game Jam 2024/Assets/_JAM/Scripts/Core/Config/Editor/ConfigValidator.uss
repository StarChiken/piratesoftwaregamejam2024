.header {
    padding: 10px;
    background-color: #2d2d30;
    border-bottom: 1px solid #3e3e42;
}

.header .title {
    font-size: 18px;
    font-weight: bold;
    color: #ffffff;
    margin-bottom: 5px;
}

.header .subtitle {
    font-size: 12px;
    color: #cccccc;
}

.toolbar {
    flex-direction: row;
    padding: 10px;
    background-color: #1e1e1e;
    border-bottom: 1px solid #3e3e42;
    align-items: center;
}

.toolbar > * {
    margin-right: 10px;
}

.toolbar Toggle {
    color: #ffffff;
    font-size: 12px;
}

.toolbar Button {
    padding: 4px 8px;
    background-color: #0078d4;
    border: none;
    border-radius: 3px;
    color: white;
    font-size: 11px;
}

.toolbar Button:hover {
    background-color: #106ebe;
}

.validation-list {
    flex: 1;
    margin: 10px;
}

.validation-item {
    padding: 10px;
    margin: 5px 0;
    background-color: #2d2d30;
    border: 1px solid #3e3e42;
    border-radius: 4px;
}

.validation-header {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 8px;
}

.validation-icon {
    width: 16px;
    height: 16px;
    margin-right: 8px;
    margin-top: 2px;
    border-radius: 2px;
}

.icon-error {
    background-color: #f44336;
}

.icon-warning {
    background-color: #ff9800;
}

.icon-info {
    background-color: #2196f3;
}

.validation-content {
    flex: 1;
}

.config-name {
    font-weight: bold;
    color: #ffffff;
    font-size: 13px;
    margin-bottom: 4px;
}

.validation-message {
    color: #cccccc;
    font-size: 12px;
    margin-bottom: 2px;
    white-space: normal;
}

.property-path {
    font-size: 10px;
    color: #888888;
}

.fix-button {
    align-self: flex-end;
    padding: 4px 8px;
    background-color: #4caf50;
    border: none;
    border-radius: 3px;
    color: white;
    font-size: 11px;
}

.fix-button:hover {
    background-color: #45a049;
}

.footer {
    padding: 10px;
    background-color: #1e1e1e;
    border-top: 1px solid #3e3e42;
}

.footer #stats {
    color: #cccccc;
    font-size: 12px;
    text-align: center;
} 